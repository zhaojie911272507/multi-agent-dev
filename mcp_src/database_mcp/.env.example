# Database MCP Server - 环境变量配置
# 复制为 .env 并填写实际值

# ========== 数据库连接（必填） ==========
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=readonly_user
DB_PASSWORD=your_password
DB_NAME=production_db

# 数据库类型: postgresql | mysql
DB_TYPE=postgresql

# MySQL 驱动（仅 DB_TYPE=mysql 时有效）: pymysql | mysqldb
# pymysql: 纯 Python，易安装
# mysqldb: 需 mysqlclient，性能更好
DB_DRIVER=pymysql

# ========== 安全与性能 ==========
# 结果集最大行数（默认 1000）
MAX_ROWS=1000

# 空闲连接超时（毫秒），超时后回收
IDLE_TIMEOUT_MS=30000

# 单次查询超时（秒）
QUERY_TIMEOUT_SEC=30

# 单次查询结果最大字节数（默认 1MB）
MAX_RESULT_SIZE_BYTES=1048576

# 是否允许写操作（UPDATE/DELETE/INSERT）
# 默认 false，仅允许 SELECT
ALLOW_WRITE_OPERATIONS=false
